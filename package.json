{
  "name": "messaging-pwa-e2e",
  "version": "1.0.0",
  "description": "E2E tests for messaging PWA",
  "scripts": {
    "format": "oxfmt --write assets/js",
    "format:check": "oxfmt --check assets/js",
    "test:unit": "vitest run --config assets/vite.config.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "pretest": "npm run build 2>/dev/null || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "oxfmt": "^0.51.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
