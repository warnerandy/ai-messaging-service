# Rust Cargo build artifacts
/target/

# Temporary files, for example, from tests.
/tmp/

# Ignore assets and uploads that are produced at build/runtime.
/priv/static/assets/
/priv/static/uploads/
/priv/uploads/

# Ignore Node.js dependencies and Playwright artifacts
/node_modules/
/.npmrc
/npm-debug.log
/playwright-report/
/test-results/
/playwright/.cache/
npm-debug.log
/assets/node_modules/
